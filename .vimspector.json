
{
  "configurations": {
    "Debug Current File": {
      "adapter": "debugpy",
      "filetypes": ["python"],
      "configuration": {
        "name": "Debug Current File",
        "request": "launch",
        "program": "${file}",
        "python": "${workspaceRoot}/.venv/bin/python",
        "cwd": "${workspaceRoot}",
        "console": "integratedTerminal",
        "justMyCode": false,
        "stopOnEntry": false
      }
    },
    "Debug Tests (pytest)": {
      "adapter": "debugpy",
      "filetypes": ["python"],
      "configuration": {
        "name": "Debug Tests (pytest)",
        "request": "launch",
        "program": "-m",
        "args": ["pytest", "${file}", "-x", "-v", "--no-header"],
        "python": "${workspaceRoot}/.venv/bin/python",
        "cwd": "${workspaceRoot}",
        "console": "integratedTerminal",
        "justMyCode": false,
        "stopOnEntry": false
      }
    },
    "Debug All Tests": {
      "adapter": "debugpy",
      "filetypes": ["python"],
      "configuration": {
        "name": "Debug All Tests",
        "request": "launch",
        "program": "-m",
        "args": ["pytest", "-x", "-v", "--no-header"],
        "python": "${workspaceRoot}/.venv/bin/python",
        "cwd": "${workspaceRoot}",
        "console": "integratedTerminal",
        "justMyCode": false,
        "stopOnEntry": false
      }
    },
    "Attach (Remote)": {
      "adapter": "debugpy",
      "filetypes": ["python"],
      "configuration": {
        "name": "Attach (Remote)",
        "request": "attach",
        "connect": {
          "host": "localhost",
          "port": 5678
        },
        "pathMappings": [
          {
            "localRoot": "${workspaceRoot}",
            "remoteRoot": "${workspaceRoot}"
          }
        ],
        "justMyCode": false
      }
    }
  }
}
